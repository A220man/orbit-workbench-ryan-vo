# Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/orbit.db

# Authentication (Keycloak OIDC & SAML Broker)
# Set DEMO_MODE=true only for local workstation testing. Startup refuses DEMO_MODE in production.
DEMO_MODE=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
JWT_SECRET_KEY=

# LLM Advisory Provider (Optional non-secret settings; server-side keys only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
